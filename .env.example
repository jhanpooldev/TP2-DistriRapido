# ==========================================================
# EcoLogistica Lima - Plantilla de variables de entorno
# ==========================================================
# Copiar este archivo como ".env" y completar los valores.
# El archivo ".env" esta excluido por .gitignore y NUNCA debe
# subirse al repositorio (CONSTITUTION.md - Variables de Entorno).
# ==========================================================


# ----------------------------------------------------------
# Base de datos - PostgreSQL
# ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=distrirapido
DB_USER=postgres
DB_PASSWORD=cambiar_por_tu_password

# Base de datos utilizada unicamente por las pruebas automatizadas.
# Debe existir y ser distinta de DB_NAME para no destruir datos de trabajo.
DB_NAME_TEST=distrirapido_test


# ----------------------------------------------------------
# Seguridad - JWT (RN-004, RN-005)
# ----------------------------------------------------------
# Generar una clave segura con: openssl rand -hex 32
JWT_SECRET=cambiar_por_una_clave_aleatoria_y_segura
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8


# ----------------------------------------------------------
# Centro de distribucion (RN-011)
# ----------------------------------------------------------
# Punto de origen y retorno de TODAS las rutas generadas.
# En el PMV se configura por variable de entorno; la
# administracion grafica de este dato se difiere a un sprint posterior.
HOME_ADDRESS=Av. Javier Prado Este 4200, Surco, Lima
HOME_LAT=-12.1150000
HOME_LNG=-76.9700000


# ----------------------------------------------------------
# Motor de ruteo
# ----------------------------------------------------------
# "haversine" = calculo local de distancias (sin red) - valor por defecto
# Un proveedor externo se integrara en el Sprint 2 mediante el adaptador de mapas.
MAP_PROVIDER=haversine

# Radio maximo de puntos de entrega admitido por el PMV (RNF-001 / EN-01).
# Si se supera, el sistema responde con un error controlado.
MAX_PUNTOS_POR_RUTA=20


# ----------------------------------------------------------
# Frontend - Vite (src/frontend)
# ----------------------------------------------------------
# URL base del Backend. Vite solo expone variables con prefijo VITE_.
VITE_API_URL=http://localhost:8000