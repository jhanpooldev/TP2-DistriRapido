# Configuración de EcoLogística Lima - Backend
APP_NAME=EcoLogistica Lima - Auth & MFA
APP_ENV=development
DEBUG=True
PORT=8000

# Seguridad y Criptografía
SECRET_KEY=ecologistica_super_secret_jwt_key_2026_distrirapido_security_token_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480       # 8 horas según regla de negocio RN-005
MFA_TOKEN_EXPIRE_MINUTES=5            # 5 minutos para token temporal de desafío MFA

# Parámetros MFA y Bloqueo de Sesión (RN-002)
MAX_FAILED_LOGIN_ATTEMPTS=3          # 3 intentos fallidos consecutivos según RN-002
ACCOUNT_LOCKOUT_MINUTES=15           # Bloqueo por 15 minutos según RN-002
TOTP_ISSUER_NAME=EcoLogistica Lima
